{
  "name": "opencode-run-stats",
  "version": "0.3.3",
  "description": "opencode plugin: at the end of a run, print input/output tokens, cache read/write, cost in USD and time \u2014 computed from events, no model call.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./tui": "./tui.js"
  },
  "files": [
    "index.js",
    "tracker.js",
    "lib.js",
    "index.d.ts",
    "dist",
    "README.md",
    "LICENSE",
    "native.js",
    "tui.js",
    "options.js"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/native.mjs",
    "build:local": "node build-local.mjs"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tokens",
    "cost",
    "stats",
    "usage"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
