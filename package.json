{
  "name": "opencode-run-stats",
  "version": "0.4.0",
  "description": "opencode plugin: print run token, cost and time stats, with exact post-idle cost backfill for standalone Deep Review reports.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./index.d.ts"
    }
  },
  "files": ["index.js", "tracker.js", "lib.js", "accounting.js", "deep-review.js", "index.d.ts", "dist", "README.md", "LICENSE", "test"],
  "scripts": {
    "test": "node test/smoke.mjs && node test/deep-review.mjs && node test/accounting.mjs && node test/e2e.mjs",
    "build:local": "node build-local.mjs"
  },
  "keywords": ["opencode", "opencode-plugin", "tokens", "cost", "stats", "usage"],
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
